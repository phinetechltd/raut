<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talking to the Raut platform -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Module 06/08: visit check-in and geofence verification.
         COARSE is declared alongside FINE because Android 12+ lets the user
         grant only approximate location; the app degrades to unverified
         check-ins rather than refusing to work. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Breadcrumb trail while a route is active. Requested separately at
         runtime and genuinely optional — declining it costs the trail, not
         the ability to sell. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

    <!-- Visit photos -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- GPS is central to the product, but the app still runs without a
         hardware fix (orders, payments and customer records all work), so
         this is not marked required. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <application
        android:label="Raut Field Sales"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- Google Maps SDK key, injected from the GOOGLE_MAPS_ANDROID_KEY
             dart-define by build.gradle.kts. Empty when no key was supplied;
             the app then draws OpenStreetMap instead. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${GOOGLE_MAPS_ANDROID_KEY}" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Module 08: the breadcrumb trail runs inside geolocator's foreground
             service so it survives the screen locking and the app being swiped
             away. Declared here as well as in the plugin so the service type is
             pinned to "location", which Android 14 requires to start it. -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ hides other packages by default, so binding to Sunmi's
             printer service fails silently without this: bindService returns
             false and no exception is thrown. -->
        <package android:name="woyou.aidlservice.jiuiv5" />
        <!-- The Directions button hands a customer's pin to a maps app:
             geo: for whatever maps app is installed (OpenStreetMap mode),
             https for Google Maps and the web fallbacks. Without these
             declarations url_launcher cannot see the handlers on Android 11+. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
