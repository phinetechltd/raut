// Raut — One Platform. Every Mile.
// Tari Africa Platforms Limited
//
// CONVENTIONS
//  - Money is stored as INTEGER minor units (KES cents). Never floats.
//    A single document therefore tops out at ~KES 21M, which is well inside
//    distributor invoice sizes; aggregates are summed in JS as Numbers.
//  - SQLite has no native enum or JSON type, so "enum" columns are Strings with
//    the allowed values documented above the field, and structured payloads are
//    JSON-encoded Strings. Nothing here is SQLite-specific, so the provider can
//    be swapped for postgresql without a schema rewrite.
//  - Every tenant-owned row carries companyId. Scoping is enforced in
//    src/lib/tenant.ts, never by trusting client input.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════
//  CORE · MULTI-TENANT ARCHITECTURE  (Phase One)
// ═══════════════════════════════════════════════════════════════════════

/// A tenant. One row per client business on the shared instance.
model Company {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  /// Registration / KRA PIN shown on invoices
  taxPin    String?
  email     String?
  phone     String?
  address   String?
  currency  String  @default("KES")
  /// ACTIVE | SUSPENDED | PENDING
  status    String  @default("PENDING")
  /// Seats permitted by the licence — proposal caps Raut at 50 users
  seatLimit Int     @default(50)
  logoUrl   String?
  /// Default geo centre for map screens
  latitude  Float?
  longitude Float?

  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  modules           CompanyModule[]
  branches          Branch[]
  users             User[]
  territories       Territory[]
  customers         Customer[]
  customerContacts  CustomerContact[]
  activities        CustomerActivity[]
  categories        ProductCategory[]
  products          Product[]
  stockLocations    StockLocation[]
  stockItems        StockItem[]
  stockMovements    StockMovement[]
  transfers         StockTransfer[]
  quotations        Quotation[]
  salesOrders       SalesOrder[]
  invoices          Invoice[]
  payments          Payment[]
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  supplierInvoices  SupplierInvoice[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  visits            Visit[]
  salesTargets      SalesTarget[]
  routes            Route[]
  geofenceEvents    GeofenceEvent[]
  locationPings     LocationPing[]
  smsTemplates      SmsTemplate[]
  smsMessages       SmsMessage[]
  auditLogs         AuditLog[]
  counters          DocumentCounter[]
  settings          Setting[]
  paymentIntents    PaymentIntent[]
  credentials       TenantCredential[]
  accounts          Account[]
  journalEntries    JournalEntry[]
  periods           AccountingPeriod[]
  etimsConfig       EtimsConfig?
  etimsSubmissions  EtimsSubmission[]
  creditNotes       CreditNote[]
  productVariants   ProductVariant[]

  @@index([status])
}

/// Per-company module licence. The commercial unit of the proposal:
/// a module the client has not bought is absent or disabled here, and every
/// route and screen that belongs to it returns 402 / hides itself.
model CompanyModule {
  id         String  @id @default(cuid())
  companyId  String
  /// CRM | SALES_POS | INVENTORY | PROCUREMENT | FINANCE
  /// FIELD_SALES | ROUTING | GEOFENCING | SMS | ANALYTICS
  moduleKey  String
  enabled    Boolean @default(false)
  /// Price paid in KES cents, for the licence record
  priceCents Int     @default(0)

  activatedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleKey])
  @@index([companyId, enabled])
}

model Branch {
  id        String  @id @default(cuid())
  companyId String
  name      String
  code      String
  phone     String?
  address   String?
  latitude  Float?
  longitude Float?
  isPrimary Boolean @default(false)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users          User[]
  customers      Customer[]
  stockLocations StockLocation[]
  invoices       Invoice[]
  salesOrders    SalesOrder[]
  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]
  expenses       Expense[]

  @@unique([companyId, code])
  @@index([companyId])
}

/// Platform + tenant users. companyId is null only for SUPER_ADMIN.
model User {
  id               String  @id @default(cuid())
  companyId        String?
  branchId         String?
  name             String
  email            String  @unique
  phone            String?
  passwordHash     String
  /// SUPER_ADMIN | COMPANY_ADMIN | BRANCH_MANAGER | SALES_MANAGER
  /// ACCOUNTANT | STOREKEEPER | FIELD_REP
  role             String
  /// ACTIVE | SUSPENDED | INVITED
  status           String  @default("ACTIVE")
  avatarUrl        String?
  /// Extra permission strings granted beyond the role, JSON array
  extraPermissions String  @default("[]")

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  refreshTokens     RefreshToken[]
  devices           Device[]
  assignedCustomers Customer[]         @relation("CustomerAssignedRep")
  activities        CustomerActivity[]
  visits            Visit[]
  routes            Route[]
  salesTargets      SalesTarget[]
  expenses          Expense[]
  geofenceEvents    GeofenceEvent[]
  locationPings     LocationPing[]
  auditLogs         AuditLog[]

  @@index([companyId, role])
  @@index([companyId, status])
}

/// Rotating refresh token for the mobile app. One live row per device.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  deviceId  String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A registered mobile handset. Anchors push delivery and the sync watermark.
model Device {
  id         String  @id @default(cuid())
  userId     String
  /// Client-generated stable install id
  deviceId   String  @unique
  platform   String
  model      String?
  appVersion String?
  pushToken  String?

  lastSyncAt DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Deduplicates mobile writes. The app sends a client UUID per mutation; a
/// replay after a dropped connection returns the stored response instead of
/// creating a second order or payment.
model IdempotencyKey {
  id         String   @id @default(cuid())
  key        String   @unique
  userId     String
  endpoint   String
  /// JSON-encoded response body replayed on a duplicate request
  response   String
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

/// Append-only security trail. Proposal Phase One: "role-based access & audit logs".
model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  userId    String?
  /// CREATE | UPDATE | DELETE | LOGIN | LOGOUT | ACTIVATE | SUSPEND | SYNC | EXPORT
  action    String
  entity    String
  entityId  String?
  /// JSON snapshot of changed fields
  changes   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([entity, entityId])
}

/// Per-company document numbering (INV-0001, PO-0001 …) without races.
model DocumentCounter {
  id        String @id @default(cuid())
  companyId String
  /// INVOICE | QUOTE | ORDER | PO | GRN | PAYMENT | EXPENSE | TRANSFER
  docType   String
  prefix    String
  nextValue Int    @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, docType])
}

model Setting {
  id        String @id @default(cuid())
  companyId String
  key       String
  value     String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
}

// ═══════════════════════════════════════════════════════════════════════
//  MODULE 01 · CRM & CUSTOMER MANAGEMENT
//  MODULE 08 · GEOFENCING (Territory polygons live here)
// ═══════════════════════════════════════════════════════════════════════

/// A sales territory. When the GEOFENCING module is licensed the polygon is
/// enforced for visit verification; otherwise it is descriptive only.
model Territory {
  id        String  @id @default(cuid())
  companyId String
  name      String
  code      String
  colour    String  @default("#2f83f7")
  /// JSON array of [lat, lng] pairs forming a closed polygon
  boundary  String  @default("[]")
  /// Fallback circular fence when no polygon is drawn
  centerLat Float?
  centerLng Float?
  radiusM   Int     @default(2000)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customers      Customer[]
  routes         Route[]
  salesTargets   SalesTarget[]
  geofenceEvents GeofenceEvent[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Customer {
  id            String  @id @default(cuid())
  companyId     String
  branchId      String?
  territoryId   String?
  assignedRepId String?

  code            String
  name            String
  /// RETAIL | WHOLESALE | DISTRIBUTOR | INSTITUTION
  type            String  @default("RETAIL")
  /// Buyer's KRA PIN. Without it an invoice cannot be claimed by the buyer,
  /// so it is optional for a kiosk and effectively required for a wholesaler.
  taxPin          String?
  /// This customer's id inside the company's own Digitax account.
  etimsCustomerId String?
  /// A | B | C — value segmentation used by CRM reporting
  segment         String  @default("C")
  phone           String?
  email           String?
  address         String?
  town            String?

  /// Map pin — Phase One "customer location capture"
  latitude        Float?
  longitude       Float?
  /// Metres a check-in may be from the pin and still count as on-site
  geofenceRadiusM Int    @default(150)

  creditLimitCents Int     @default(0)
  paymentTermsDays Int     @default(0)
  /// Denormalised outstanding receivable, recalculated on invoice/payment write
  balanceCents     Int     @default(0)
  /// ACTIVE | DORMANT | BLOCKED
  status           String  @default("ACTIVE")
  notes            String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch      Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  territory   Territory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  assignedRep User?      @relation("CustomerAssignedRep", fields: [assignedRepId], references: [id], onDelete: SetNull)

  contacts       CustomerContact[]
  activities     CustomerActivity[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]
  invoices       Invoice[]
  payments       Payment[]
  visits         Visit[]
  routeStops     RouteStop[]
  smsMessages    SmsMessage[]
  paymentIntents PaymentIntent[]
  creditNotes    CreditNote[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, territoryId])
  @@index([companyId, assignedRepId])
  @@index([companyId, updatedAt])
}

model CustomerContact {
  id         String  @id @default(cuid())
  companyId  String
  customerId String
  name       String
  role       String?
  phone      String?
  email      String?
  isPrimary  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId, customerId])
}

/// Follow-ups and the activity log required by Module 01.
model CustomerActivity {
  id          String    @id @default(cuid())
  companyId   String
  customerId  String
  userId      String?
  /// CALL | VISIT | EMAIL | SMS | NOTE | FOLLOW_UP | ORDER | PAYMENT
  type        String
  subject     String
  body        String?
  /// OPEN | DONE | CANCELLED — only meaningful for FOLLOW_UP
  status      String    @default("DONE")
  dueAt       DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, customerId, createdAt])
  @@index([companyId, status, dueAt])
}

// ═══════════════════════════════════════════════════════════════════════
//  MODULE 03 · INVENTORY MANAGEMENT  (catalogue is shared with Sales/POS)
// ═══════════════════════════════════════════════════════════════════════

model ProductCategory {
  id        String  @id @default(cuid())
  companyId String
  name      String
  code      String
  parentId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Product {
  id         String  @id @default(cuid())
  companyId  String
  categoryId String?

  sku          String
  name         String
  description  String?
  /// PC | CTN | KG | L | DZ …
  unit         String  @default("PC")
  /// Units per carton, for van-sales pack maths
  unitsPerPack Int     @default(1)
  barcode      String?

  sellPriceCents Int @default(0)
  costPriceCents Int @default(0)
  /// VAT percentage × 100 (1600 = 16%)
  taxRateBp      Int @default(1600)

  /// eTIMS classification. KRA will not accept a line without these, and they
  /// describe the goods rather than the price, so they live on the product and
  /// are copied onto the submission rather than derived at send time.
  /// 8-digit UNSPSC. 99000000 (VAT Act) is the legitimate generic fallback.
  etimsItemClassCode String?
  /// 1 raw material | 2 finished product | 3 service
  etimsItemTypeCode  String?
  /// A exempt | B 16% | C 0% | D non-VAT | E 8%
  etimsTaxTypeCode   String?
  /// eTIMS quantity unit, e.g. U (pieces), KG, L
  etimsQuantityUnit  String?
  /// eTIMS packaging unit, e.g. CT (carton), BG (bag), NT
  etimsPackageUnit   String?
  /// ISO country of origin, e.g. KE
  etimsOriginNation  String?
  /// Assigned by eTIMS once registered. Belongs to one Digitax account, so it
  /// is cleared when the company's credentials change.
  etimsItemCode      String?
  /// UNREGISTERED | PENDING | REGISTERED | FAILED
  etimsStatus        String    @default("UNREGISTERED")
  etimsSyncedAt      DateTime?
  etimsError         String?

  reorderLevel Int     @default(0)
  trackStock   Boolean @default(true)
  active       Boolean @default(true)
  imageUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  stockItems      StockItem[]
  stockMovements  StockMovement[]
  quotationLines  QuotationLine[]
  orderLines      SalesOrderLine[]
  invoiceLines    InvoiceLine[]
  poLines         PurchaseOrderLine[]
  grnLines        GoodsReceiptLine[]
  creditNoteLines CreditNoteLine[]
  variants        ProductVariant[]
  transferLines   StockTransferLine[]

  @@unique([companyId, sku])
  @@index([companyId, active])
  @@index([companyId, updatedAt])
}

/// A stockable place: main store, branch store, or a rep's van.
model StockLocation {
  id          String  @id @default(cuid())
  companyId   String
  branchId    String?
  name        String
  code        String
  /// WAREHOUSE | STORE | VAN
  type        String  @default("WAREHOUSE")
  /// Set when type = VAN, links the rolling stock to its rep
  ownerUserId String?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  stockItems    StockItem[]
  movements     StockMovement[]
  transfersOut  StockTransfer[] @relation("TransferFrom")
  transfersIn   StockTransfer[] @relation("TransferTo")
  invoices      Invoice[]
  goodsReceipts GoodsReceipt[]

  @@unique([companyId, code])
  @@index([companyId])
}

model StockItem {
  id         String @id @default(cuid())
  companyId  String
  productId  String
  locationId String

  /// On-hand quantity in base units
  quantity Int @default(0)
  /// Committed to unfulfilled orders
  reserved Int @default(0)

  updatedAt DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([companyId, locationId])
}

/// Immutable ledger of every stock change. Balances are derived from these.
model StockMovement {
  id         String @id @default(cuid())
  companyId  String
  productId  String
  locationId String

  /// PURCHASE | SALE | TRANSFER_IN | TRANSFER_OUT | ADJUSTMENT | RETURN | OPENING
  type          String
  /// Signed: positive increases the location's stock
  quantity      Int
  balanceAfter  Int    @default(0)
  unitCostCents Int    @default(0)

  /// Originating document, e.g. INVOICE / GRN / TRANSFER
  refType String?
  refId   String?
  note    String?

  createdById String?
  createdAt   DateTime @default(now())

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([companyId, productId, createdAt])
  @@index([companyId, refType, refId])
}

model StockTransfer {
  id             String  @id @default(cuid())
  companyId      String
  number         String
  fromLocationId String
  toLocationId   String
  /// DRAFT | IN_TRANSIT | RECEIVED | CANCELLED
  status         String  @default("DRAFT")
  note           String?

  dispatchedAt DateTime?
  receivedAt   DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromLocation StockLocation       @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   StockLocation       @relation("TransferTo", fields: [toLocationId], references: [id])
  lines        StockTransferLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

model StockTransferLine {
  id         String @id @default(cuid())
  transferId String
  productId  String
  quantity   Int
  received   Int    @default(0)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@index([transferId])
}

// ═══════════════════════════════════════════════════════════════════════
//  MODULE 02 · SALES & POS
// ═══════════════════════════════════════════════════════════════════════

model Quotation {
  id         String  @id @default(cuid())
  companyId  String
  branchId   String?
  customerId String
  number     String

  /// DRAFT | SENT | ACCEPTED | REJECTED | EXPIRED | CONVERTED
  status     String    @default("DRAFT")
  issueDate  DateTime  @default(now())
  validUntil DateTime?

  subtotalCents Int     @default(0)
  discountCents Int     @default(0)
  taxCents      Int     @default(0)
  totalCents    Int     @default(0)
  note          String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch   Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lines    QuotationLine[]
  orders   SalesOrder[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

model QuotationLine {
  id             String @id @default(cuid())
  quotationId    String
  productId      String
  description    String
  quantity       Int
  unitPriceCents Int
  discountCents  Int    @default(0)
  taxRateBp      Int    @default(1600)
  lineTotalCents Int

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([quotationId])
}

model SalesOrder {
  id          String  @id @default(cuid())
  companyId   String
  branchId    String?
  customerId  String
  quotationId String?
  number      String

  /// DRAFT | CONFIRMED | PARTIALLY_FULFILLED | FULFILLED | INVOICED | CANCELLED
  status       String    @default("DRAFT")
  /// CONSOLE | POS | FIELD — provenance matters for rep commission
  channel      String    @default("CONSOLE")
  orderDate    DateTime  @default(now())
  deliveryDate DateTime?

  subtotalCents Int     @default(0)
  discountCents Int     @default(0)
  taxCents      Int     @default(0)
  totalCents    Int     @default(0)
  note          String?

  /// Set when the order was captured during a field visit
  visitId    String? @unique
  /// Client UUID from the mobile app; the offline write's identity
  clientUuid String? @unique

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotation Quotation?       @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  visit     Visit?           @relation(fields: [visitId], references: [id], onDelete: SetNull)
  lines     SalesOrderLine[]
  invoices  Invoice[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, updatedAt])
}

model SalesOrderLine {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  /// The selling unit, when the line was sold as one.
  variantId   String?
  /// Snapshotted, because renaming "Carton of 12" later must not rewrite an
  /// invoice that has already been printed and filed with KRA.
  variantName String?

  description    String
  quantity       Int
  baseQuantity   Int    @default(0)
  fulfilled      Int    @default(0)
  unitPriceCents Int
  discountCents  Int    @default(0)
  taxRateBp      Int    @default(1600)
  lineTotalCents Int

  order   SalesOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Invoice {
  id         String  @id @default(cuid())
  companyId  String
  branchId   String?
  customerId String
  orderId    String?
  locationId String?
  number     String

  /// DRAFT | ISSUED | PARTIALLY_PAID | PAID | OVERDUE | CANCELLED
  status    String    @default("DRAFT")
  channel   String    @default("CONSOLE")
  issueDate DateTime  @default(now())
  dueDate   DateTime?

  subtotalCents Int     @default(0)
  discountCents Int     @default(0)
  taxCents      Int     @default(0)
  totalCents    Int     @default(0)
  paidCents     Int     @default(0)
  note          String?

  /// NOT_APPLICABLE | QUEUED | SUBMITTED | ACCEPTED | REJECTED
  /// NOT_APPLICABLE is the honest default: most companies do not file through
  /// this system, and an invoice they raise is not "pending" anything.
  etimsStatus        String    @default("NOT_APPLICABLE")
  /// Digitax's id for the sale, needed to raise a credit note against it.
  etimsSaleId        String?
  /// The control code (receipt_signature). This, with the QR, is what makes
  /// the printed document a valid tax invoice.
  etimsControlCode   String?
  etimsInvoiceNumber String?
  etimsSerialNumber  String?
  etimsReceiptNumber Int?
  etimsQrUrl         String?
  etimsOfflineUrl    String?
  etimsSubmittedAt   DateTime?
  etimsError         String?

  visitId    String?
  clientUuid String? @unique

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch      Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order       SalesOrder?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  location    StockLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  lines       InvoiceLine[]
  allocations PaymentAllocation[]
  creditNotes CreditNote[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, dueDate])
  @@index([companyId, updatedAt])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String
  /// The selling unit, when the line was sold as one.
  variantId   String?
  /// Snapshotted, because renaming "Carton of 12" later must not rewrite an
  /// invoice that has already been printed and filed with KRA.
  variantName String?

  description    String
  /// Quantity in the unit sold: 2 means two cartons, not twenty-four bottles.
  quantity       Int
  /// The same line in base units, which is what stock and cost of sales
  /// move on. Equal to quantity where no variant was used.
  baseQuantity   Int    @default(0)
  unitPriceCents Int
  discountCents  Int    @default(0)
  taxRateBp      Int    @default(1600)
  lineTotalCents Int

  invoice Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

/// Money received from a customer. Allocated across one or more invoices.
model Payment {
  id         String @id @default(cuid())
  companyId  String
  customerId String
  number     String

  amountCents Int
  /// CASH | MPESA | BANK | CHEQUE | CREDIT_NOTE | PAYSTACK | MPESA_STK | KCB_BUNI
  method      String   @default("CASH")
  reference   String?
  paidAt      DateTime @default(now())
  note        String?

  visitId    String?
  clientUuid String? @unique

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@unique([companyId, number])
  @@index([companyId, customerId])
  @@index([companyId, paidAt])
  @@index([companyId, updatedAt])
}

model PaymentAllocation {
  id          String @id @default(cuid())
  paymentId   String
  invoiceId   String
  amountCents Int

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

// ═══════════════════════════════════════════════════════════════════════
//  MODULE 04 · PROCUREMENT & SUPPLIERS
// ═══════════════════════════════════════════════════════════════════════

model Supplier {
  id               String  @id @default(cuid())
  companyId        String
  code             String
  name             String
  contactName      String?
  phone            String?
  email            String?
  address          String?
  taxPin           String?
  paymentTermsDays Int     @default(30)
  balanceCents     Int     @default(0)
  status           String  @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  invoices       SupplierInvoice[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

model PurchaseOrder {
  id         String  @id @default(cuid())
  companyId  String
  branchId   String?
  supplierId String
  number     String

  /// DRAFT | SENT | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  status     String    @default("DRAFT")
  orderDate  DateTime  @default(now())
  expectedAt DateTime?

  subtotalCents Int     @default(0)
  taxCents      Int     @default(0)
  totalCents    Int     @default(0)
  note          String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch   Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

model PurchaseOrderLine {
  id             String @id @default(cuid())
  poId           String
  productId      String
  description    String
  quantity       Int
  received       Int    @default(0)
  unitCostCents  Int
  taxRateBp      Int    @default(1600)
  lineTotalCents Int

  po      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])

  @@index([poId])
}

model GoodsReceipt {
  id         String  @id @default(cuid())
  companyId  String
  supplierId String
  poId       String?
  locationId String
  number     String

  /// DRAFT | POSTED
  status     String   @default("DRAFT")
  receivedAt DateTime @default(now())
  note       String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  po       PurchaseOrder?     @relation(fields: [poId], references: [id], onDelete: SetNull)
  location StockLocation      @relation(fields: [locationId], references: [id])
  lines    GoodsReceiptLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

model GoodsReceiptLine {
  id            String @id @default(cuid())
  grnId         String
  productId     String
  quantity      Int
  unitCostCents Int

  grn     GoodsReceipt @relation(fields: [grnId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@index([grnId])
}

model SupplierInvoice {
  id          String  @id @default(cuid())
  companyId   String
  supplierId  String
  number      String
  supplierRef String?

  /// UNPAID | PARTIALLY_PAID | PAID | CANCELLED
  status     String    @default("UNPAID")
  issueDate  DateTime  @default(now())
  dueDate    DateTime?
  totalCents Int       @default(0)
  paidCents  Int       @default(0)
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([companyId, number])
  @@index([companyId, status])
}

// ═══════════════════════════════════════════════════════════════════════
//  MODULE 05 · FINANCE, EXPENSES & RECEIVABLES
// ═══════════════════════════════════════════════════════════════════════

model ExpenseCategory {
  id        String @id @default(cuid())
  companyId String

  /// Ledger account this category posts to. Null falls back to 6000.
  accountCode            String?
  name                   String
  code                   String
  /// Claims above this need a manager approval; 0 = always approve
  approvalThresholdCents Int     @default(0)
  active                 Boolean @default(true)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([companyId, code])
}

/// Covers both office expenses and field-rep expense claims (proposal p.3).
model Expense {
  id         String  @id @default(cuid())
  companyId  String
  branchId   String?
  categoryId String?
  userId     String?

  number        String
  description   String
  amountCents   Int
  /// DRAFT | SUBMITTED | APPROVED | REJECTED | PAID
  status        String   @default("DRAFT")
  incurredAt    DateTime @default(now())
  /// CASH | MPESA | BANK | PETTY_CASH
  paymentMethod String   @default("CASH")
  receiptUrl    String?
  /// Where the claim was raised — field claims capture the rep's position
  latitude      Float?
  longitude     Float?

  approvedById String?
  approvedAt   DateTime?
  rejectReason String?
  clientUuid   String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch   Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, userId])
}

// ═══════════════════════════════════════════════════════════════════════
//  MODULE 06 · FIELD SALES MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════

model Visit {
  id         String  @id @default(cuid())
  companyId  String
  customerId String
  repId      String
  routeId    String?

  /// SCHEDULED | IN_PROGRESS | COMPLETED | MISSED | CANCELLED
  status      String   @default("SCHEDULED")
  /// SALES | COLLECTION | DELIVERY | PROSPECTING | SUPPORT
  purpose     String   @default("SALES")
  scheduledAt DateTime

  checkInAt        DateTime?
  checkInLat       Float?
  checkInLng       Float?
  checkInAccuracyM Int?

  checkOutAt  DateTime?
  checkOutLat Float?
  checkOutLng Float?

  /// Module 08 output: was the check-in inside the customer's fence?
  geofenceVerified      Boolean @default(false)
  /// Metres between check-in point and the customer pin
  distanceFromCustomerM Int?
  /// Minutes on site, derived at check-out
  durationMin           Int?

  outcome String?
  notes   String?

  clientUuid String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rep      User     @relation(fields: [repId], references: [id], onDelete: Cascade)
  route    Route?   @relation(fields: [routeId], references: [id], onDelete: SetNull)

  photos VisitPhoto[]
  order  SalesOrder?

  @@index([companyId, repId, scheduledAt])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([companyId, updatedAt])
}

model VisitPhoto {
  id         String   @id @default(cuid())
  visitId    String
  /// Stored under /uploads/visits/<id>.jpg by the upload route
  url        String
  caption    String?
  latitude   Float?
  longitude  Float?
  takenAt    DateTime @default(now())
  clientUuid String?  @unique

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
}

model SalesTarget {
  id          String  @id @default(cuid())
  companyId   String
  repId       String?
  territoryId String?

  /// MONTHLY | QUARTERLY | ANNUAL
  period      String   @default("MONTHLY")
  periodStart DateTime
  periodEnd   DateTime

  targetSalesCents      Int @default(0)
  targetCollectionCents Int @default(0)
  targetVisits          Int @default(0)
  targetNewCustomers    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rep       User?      @relation(fields: [repId], references: [id], onDelete: Cascade)
  territory Territory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)

  @@index([companyId, repId, periodStart])
}

// ═══════════════════════════════════════════════════════════════════════
//  MODULE 07 · SMART ROUTING
// ═══════════════════════════════════════════════════════════════════════

model Route {
  id          String  @id @default(cuid())
  companyId   String
  repId       String
  territoryId String?

  name      String
  routeDate DateTime
  /// PLANNED | ACTIVE | COMPLETED | CANCELLED
  status    String   @default("PLANNED")

  /// Optimised total travel distance, metres
  totalDistanceM Int    @default(0)
  /// Estimated driving time at the planning speed assumption, minutes
  estimatedMin   Int    @default(0)
  startLat       Float?
  startLng       Float?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rep       User       @relation(fields: [repId], references: [id], onDelete: Cascade)
  territory Territory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)

  stops  RouteStop[]
  visits Visit[]

  @@index([companyId, repId, routeDate])
  @@index([companyId, updatedAt])
}

model RouteStop {
  id         String @id @default(cuid())
  routeId    String
  customerId String

  sequence     Int
  /// PENDING | ARRIVED | DONE | SKIPPED
  status       String    @default("PENDING")
  plannedAt    DateTime?
  /// Distance from the previous stop, metres
  legDistanceM Int       @default(0)
  legMin       Int       @default(0)
  skipReason   String?

  route    Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([routeId, customerId])
  @@index([routeId, sequence])
}

// ═══════════════════════════════════════════════════════════════════════
//  MODULE 08 · GEOFENCING & LOCATION INTELLIGENCE
// ═══════════════════════════════════════════════════════════════════════

model GeofenceEvent {
  id          String  @id @default(cuid())
  companyId   String
  userId      String
  territoryId String?

  /// ENTER | EXIT | VISIT_VERIFIED | VISIT_REJECTED | OUT_OF_ZONE
  type       String
  latitude   Float
  longitude  Float
  /// Free-text detail, e.g. "check-in 412m from customer pin"
  detail     String?
  refType    String?
  refId      String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  territory Territory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)

  @@index([companyId, userId, occurredAt])
  @@index([companyId, type])
}

/// Background location breadcrumbs from the mobile app. High volume — pruned
/// by retention policy rather than kept forever.
model LocationPing {
  id        String @id @default(cuid())
  companyId String
  userId    String

  latitude   Float
  longitude  Float
  accuracyM  Int?
  speedMps   Float?
  heading    Float?
  batteryPct Int?
  isMoving   Boolean  @default(true)
  recordedAt DateTime
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, recordedAt])
}

// ═══════════════════════════════════════════════════════════════════════
//  MODULE 09 · SMS COMMUNICATION
// ═══════════════════════════════════════════════════════════════════════

model SmsTemplate {
  id        String  @id @default(cuid())
  companyId String
  /// ORDER_CONFIRMATION | PAYMENT_RECEIPT | BALANCE_REMINDER | PROMOTION | VISIT_REMINDER
  key       String
  name      String
  /// Placeholders in {{braces}}: {{customer}}, {{amount}}, {{balance}}, {{number}}
  body      String
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
}

model SmsMessage {
  id         String  @id @default(cuid())
  companyId  String
  customerId String?

  toPhone     String
  body        String
  /// QUEUED | SENT | DELIVERED | FAILED
  status      String  @default("QUEUED")
  provider    String  @default("console")
  providerRef String?
  templateKey String?
  costCents   Int     @default(0)
  error       String?

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, createdAt])
}

/// A gateway collection attempt, kept apart from `Payment`.
///
/// A Payment is money the business has. An intent is a request that may still
/// fail, time out, or be abandoned at the PIN prompt — and for M-Pesa it exists
/// for minutes while the customer decides. Settling them into the same table
/// would either pollute the ledger with attempts or lose the audit trail of
/// what was tried; so the intent is the attempt, and `paymentId` is set only
/// once the provider confirms and a real Payment is written.
model PaymentIntent {
  id         String  @id @default(cuid())
  companyId  String
  customerId String
  visitId    String?

  /// PAYSTACK | MPESA_DARAJA | KCB_BUNI
  provider    String
  amountCents Int
  currency    String @default("KES")

  /// Payer contact, as the provider needs it: MSISDN for M-Pesa and KCB,
  /// email for Paystack.
  payerPhone String?
  payerEmail String?

  /// PENDING | PROCESSING | SUCCEEDED | FAILED | CANCELLED | EXPIRED
  status        String  @default("PENDING")
  failureReason String?

  /// The provider's own handle: Paystack reference, Daraja CheckoutRequestID,
  /// KCB transaction id. Unique per provider so a replayed webhook is a no-op.
  providerRef     String?
  /// The provider's confirmation code shown to the customer (M-Pesa receipt).
  receiptRef      String?
  /// Raw callback body, kept verbatim for dispute resolution. SQLite has no
  /// JSON type, so this is the serialised string.
  providerPayload String?

  /// Client-generated idempotency key, same contract as the offline outbox.
  clientUuid String? @unique

  /// Set once the provider confirms and the money is booked.
  paymentId String? @unique

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRef])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([companyId, updatedAt])
}

/// A gateway or tax-authority credential belonging to one company.
///
/// Encrypted with AES-256-GCM by `src/lib/secrets.ts`, with the companyId bound
/// in as additional authenticated data — a blob moved between tenant rows fails
/// to decrypt rather than leaking. The master key lives in the environment, so
/// a database dump on its own is inert.
///
/// `label` is the only part safe to show an admin: the last few characters of
/// the key, so they can tell which account is wired up without the secret ever
/// travelling back to the browser.
model TenantCredential {
  id        String @id @default(cuid())
  companyId String

  /// PAYSTACK | MPESA_DARAJA | KCB_BUNI | DIGITAX
  provider String

  cipherText String
  iv         String
  authTag    String

  /// Masked hint, e.g. "••••4f2a". Never the secret itself.
  label  String?
  active Boolean @default(true)

  /// Result of the last "test connection", so an admin can see a key went bad
  /// before a rep discovers it at a counter.
  lastTestedAt DateTime?
  lastTestOk   Boolean?
  lastTestNote String?

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@index([companyId, active])
}

/// A line in the chart of accounts.
///
/// Codes follow the conventional ranges so an accountant recognises them on
/// sight: 1xxx assets, 2xxx liabilities, 3xxx equity, 4xxx income, 5xxx cost of
/// sales, 6xxx expenses. `isPostable` is false for headers that exist only to
/// group children — posting to a header is how a chart of accounts rots.
model Account {
  id        String @id @default(cuid())
  companyId String

  code String
  name String
  /// ASSET | LIABILITY | EQUITY | INCOME | EXPENSE
  type String

  parentId   String?
  isPostable Boolean @default(true)
  /// Set on the accounts the posting rules look up by role, so a company can
  /// rename "Bank" without breaking the machinery that posts to it.
  systemKey  String?
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children Account[]     @relation("AccountTree")
  lines    JournalLine[]

  @@unique([companyId, code])
  @@unique([companyId, systemKey])
  @@index([companyId, type])
}

/// One balanced double-entry transaction.
///
/// Entries are never edited or deleted. A correction is a reversing entry —
/// an audit trail you can rewrite is not one.
///
/// The unique on (companyId, refType, refId, sourceKind) is what makes posting
/// idempotent: replaying an invoice, or a callback arriving twice, cannot
/// double-post. `sourceKind` distinguishes the several entries one document can
/// produce — an invoice raises both revenue and cost of sales.
model JournalEntry {
  id        String @id @default(cuid())
  companyId String

  number String
  date   DateTime
  memo   String?

  /// The document this came from: Invoice | Payment | StockMovement | Expense …
  refType    String
  refId      String
  /// REVENUE | COGS | SETTLEMENT | RECEIPT | PURCHASE | ADJUSTMENT | REVERSAL …
  sourceKind String

  /// Set on the entry that reverses this one, and vice versa.
  reversedById String? @unique
  reversalOfId String?

  postedById String?
  createdAt  DateTime @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   JournalLine[]

  reversedBy JournalEntry? @relation("Reversal", fields: [reversedById], references: [id])
  reverses   JournalEntry? @relation("Reversal")

  @@unique([companyId, number])
  @@unique([companyId, refType, refId, sourceKind])
  @@index([companyId, date])
  @@index([companyId, refType, refId])
}

/// One side of an entry. Exactly one of debit/credit is non-zero.
model JournalLine {
  id        String @id @default(cuid())
  entryId   String
  accountId String

  debitCents  Int @default(0)
  creditCents Int @default(0)

  memo String?

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
}

/// A month, and whether it is closed.
///
/// A closed period refuses new postings, which is what stops last quarter's
/// reported profit changing after it has been reported.
model AccountingPeriod {
  id        String @id @default(cuid())
  companyId String

  year  Int
  month Int

  closedAt   DateTime?
  closedById String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year, month])
}

// ---------------------------------------------------------------------------
// eTIMS  (KRA electronic tax invoicing, through Digitax)
// ---------------------------------------------------------------------------

/// A company's own eTIMS settings.
///
/// Separate from the module licence on purpose. The licence says the company
/// has *bought* eTIMS; this says whether it is *switched on*. A company that
/// has paid but has not finished onboarding with KRA must be able to run with
/// it off, and turning it off must never stop them trading.
model EtimsConfig {
  id        String @id @default(cuid())
  companyId String @unique

  /// The switch. False means invoices issue exactly as before and nothing is
  /// transmitted or queued.
  enabled      Boolean @default(false)
  /// SANDBOX | LIVE. A live key files real returns under a real PIN.
  environment  String  @default("SANDBOX")
  /// Transmit on issue, or leave submissions for someone to release by hand.
  autoTransmit Boolean @default(true)

  /// Nothing raised before this date is transmitted. Without it, switching the
  /// feature on would push the entire back catalogue at KRA.
  activeFrom DateTime?

  /// Read back from GET /etims-info so an admin can see which business and
  /// branch the stored key actually belongs to.
  businessId String?
  branchId   String?
  branchName String?
  taxPin     String?

  /// Fallbacks applied to products that have no classification of their own.
  defaultItemClassCode String @default("99000000")
  defaultItemTypeCode  String @default("2")
  defaultTaxTypeCode   String @default("B")
  defaultQuantityUnit  String @default("U")
  defaultPackageUnit   String @default("NT")
  defaultOriginNation  String @default("KE")

  /// Which credential produced the Digitax ids held on products, customers and
  /// invoices. When the key or PIN is replaced this changes, and those ids —
  /// which belong to the *old* Digitax business — must be cleared before
  /// anything is submitted against the new one.
  credentialFingerprint String?

  lastVerifiedAt DateTime?
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// Every attempt at every transmission, request and response kept verbatim.
///
/// When KRA disputes a figure two years from now, the answer has to be what was
/// actually sent, not what today's code would send.
model EtimsSubmission {
  id        String @id @default(cuid())
  companyId String

  /// SALE | CREDIT_NOTE | ITEM | CUSTOMER | STOCK
  docType String
  /// Local id of the document this is for.
  docId   String

  attempt Int    @default(1)
  /// PENDING | SENT | ACCEPTED | REJECTED | FAILED
  status  String @default("PENDING")

  endpoint   String?
  request    String?
  response   String?
  /// HTTP status, where there was one.
  httpStatus Int?
  error      String?
  /// Set when a failure is worth retrying. A permanent rejection has none.
  retryAfter DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([companyId, docType, docId])
}

/// A credit note against an issued invoice.
///
/// KRA requires a reversal to be its own transmitted document referencing the
/// original sale. Raut had returns as stock movements with no document behind
/// them, which cannot be filed at all.
model CreditNote {
  id         String @id @default(cuid())
  companyId  String
  invoiceId  String
  customerId String
  number     String

  /// DRAFT | ISSUED | CANCELLED
  status String @default("DRAFT")
  reason String

  issueDate DateTime @default(now())

  subtotalCents Int @default(0)
  taxCents      Int @default(0)
  totalCents    Int @default(0)

  /// Whether the returned goods went back into stock. A damaged return is
  /// credited but not restocked, and the two must not be assumed together.
  restock Boolean @default(true)

  etimsStatus        String    @default("NOT_APPLICABLE")
  etimsSaleId        String?
  etimsControlCode   String?
  etimsInvoiceNumber String?
  etimsSerialNumber  String?
  etimsReceiptNumber Int?
  etimsQrUrl         String?
  etimsOfflineUrl    String?
  etimsSubmittedAt   DateTime?
  etimsError         String?

  clientUuid  String?  @unique
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice  Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lines    CreditNoteLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, invoiceId])
}

model CreditNoteLine {
  id            String  @id @default(cuid())
  creditNoteId  String
  productId     String
  /// The line on the original invoice being credited, so a partial return can
  /// be matched back to what was sold.
  invoiceLineId String?

  /// The selling unit credited, snapshotted like the invoice line it reverses.
  variantId   String?
  variantName String?

  description    String
  /// Quantity in the unit sold: 2 means two cartons returned.
  quantity       Int
  /// The same in base units. This is what goes back on the shelf and what is
  /// filed with KRA, because the original sale was filed the same way.
  baseQuantity   Int    @default(0)
  unitPriceCents Int
  taxRateBp      Int    @default(1600)
  lineTotalCents Int

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@index([creditNoteId])
}

/// A way of selling a product.
///
/// A distributor buys cartons and sells cartons, dozens and single bottles.
/// Modelling those as three products means three stock pools that have to be
/// kept in step by hand, and they never are. Here there is **one pool, held in
/// base units**, and a variant is a multiplier onto it: selling two cartons of
/// twelve takes twenty-four base units off the shelf.
///
/// That is what makes stock splitting arithmetic rather than a document. There
/// is nothing to convert, because the carton was never a separate thing.
///
/// Price is per variant, not derived from the base price. A carton is cheaper
/// per bottle than a bottle is, and deriving it would either lose that or
/// introduce rounding drift on every line.
model ProductVariant {
  id        String @id @default(cuid())
  companyId String
  productId String

  /// What a rep sees on the button: "Carton of 12", "Dozen", "Single".
  name    String
  sku     String
  barcode String?

  /// Base units in one of these. 1 is the base unit itself.
  unitsPerVariant Int @default(1)
  sellPriceCents  Int @default(0)

  /// The variant offered first on the POS. Exactly one per product should hold
  /// it; the app falls back to the lowest unitsPerVariant if none does.
  isDefault Boolean @default(false)
  active    Boolean @default(true)

  /// eTIMS classifies what appears on the invoice line, which is the variant
  /// rather than the product. Null falls back to the product's own.
  etimsItemClassCode String?
  etimsPackageUnit   String?
  etimsItemCode      String?
  etimsStatus        String  @default("UNREGISTERED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  invoiceLines InvoiceLine[]
  orderLines   SalesOrderLine[]

  @@unique([companyId, sku])
  @@index([companyId, productId, active])
}
