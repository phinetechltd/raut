# Raut — local development environment
DATABASE_URL="file:./raut.db"

# Signing key for console sessions and mobile access/refresh tokens.
# Replace in every deployed environment.
AUTH_SECRET="replace-me-with-a-long-random-string"

ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=30

# SMS module (Module 09). Provider adapters: console | africastalking | twilio
SMS_PROVIDER="console"
SMS_SENDER_ID="Raut"
SMS_API_KEY=""
SMS_API_USERNAME=""

# Base URL the Flutter app points at during development.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Maps ────────────────────────────────────────────────────────────
# Which basemap the console draws and the field app's Directions open:
# osm (OpenStreetMap — no key, no quota) or google. Each company can
# override this under Settings → Maps; this is the default they inherit.
MAPS_DEFAULT_PROVIDER="osm"
# Optional platform-wide Google Maps *browser* key (Maps JavaScript API).
# Companies may choose Google Maps on this key without supplying their own.
# Restrict it in Google Cloud to the console's domain — it is sent to every
# browser that opens a map, so the referrer restriction is the only thing
# stopping someone else billing it.
GOOGLE_MAPS_API_KEY=""
# Optional Map ID (Google Cloud → Map management). Advanced Markers need one
# in production; without it Google's DEMO_MAP_ID is used.
GOOGLE_MAPS_MAP_ID=""

# ── Payment gateways ────────────────────────────────────────────────
# Platform-wide defaults. A company that stores its own credentials under
# Settings → Payments uses ONLY its own bundle (encrypted with CREDENTIALS_KEY);
# a company with none uses these. The two are never mixed. A gateway with no
# credentials anywhere is simply not offered to reps.
#
# Every outbound provider call is bounded by this timeout (ms). A call that
# times out after the request left is reconciled, not declared failed.
PAYMENTS_TIMEOUT_MS=20000
# Shared token for the systemd timer that reconciles open collections every
# five minutes (POST /api/v1/payments/reconcile). Generate with
# `openssl rand -hex 32`. The endpoint refuses everything when unset.
PAYMENTS_RUNNER_TOKEN=
# Tenant-settable base URLs are limited to the official hosts
# (api.paystack.co, api/sandbox.safaricom.co.ke, api/uat.buni.kcbgroup.com).
# Set to 1 only on a test box pointed at mocks.
PAYMENTS_ALLOW_CUSTOM_HOSTS=
# A production deployment (NODE_ENV=production) refuses a Paystack sk_test_
# key or MPESA_ENV=sandbox. Set to 1 to allow them, e.g. on staging.
PAYMENTS_ALLOW_TEST_KEYS=

# Paystack (cards, bank, mobile money). On the Paystack dashboard set the
# webhook URL to ${PUBLIC_BASE_URL}/api/v1/payments/callbacks/paystack; the
# payer's browser returns to /api/v1/payments/return/paystack automatically.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Deployment-level override of the API host (tests point it at a mock).
PAYSTACK_BASE_URL=""

# M-Pesa via Safaricom Daraja. MPESA_ENV=sandbox|production
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
# CustomerPayBillOnline for a paybill, CustomerBuyGoodsOnline for a till
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"
# Deployment-level override of the Daraja host (tests point it at a mock).
# Empty = chosen from MPESA_ENV.
MPESA_BASE_URL=""

# KCB Buni. KCB_ENV=sandbox|production
KCB_ENV="sandbox"
KCB_CONSUMER_KEY=""
KCB_CONSUMER_SECRET=""
KCB_TILL_NUMBER=""
KCB_WEBHOOK_SECRET=""
KCB_BASE_URL=""

# Where providers should send callbacks. Must be publicly reachable — a
# handset's own origin is not, so this is configuration rather than inference.
PUBLIC_BASE_URL="https://raut.co.ke"

# Master key for tenant credential encryption. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=""

# ── eTIMS (KRA, via Digitax) ───────────────────────────────────────────
# Per-company API keys live in the encrypted credential vault, NOT here.
# There is deliberately no platform-wide Digitax key: filing one company's
# sales under whatever PIN happens to be in the environment would be a false
# return in someone else's name.
#
# Deployment-level only:
DIGITAX_BASE_URL=https://api.digitax.tech/ke/v2
# Shared token for the systemd timer that drains the queue. Generate with
# `openssl rand -hex 32`. The runner endpoint refuses everything when unset.
ETIMS_RUNNER_TOKEN=
