# Raut — local development environment
DATABASE_URL="file:./raut.db"

# Signing key for console sessions and mobile access/refresh tokens.
# Replace in every deployed environment.
AUTH_SECRET="replace-me-with-a-long-random-string"

ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=30

# SMS module (Module 09). Provider adapters: console | africastalking | twilio
SMS_PROVIDER="console"
SMS_SENDER_ID="Raut"
SMS_API_KEY=""
SMS_API_USERNAME=""

# Base URL the Flutter app points at during development.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
