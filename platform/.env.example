# Raut — local development environment
DATABASE_URL="file:./raut.db"

# Signing key for console sessions and mobile access/refresh tokens.
# Replace in every deployed environment.
AUTH_SECRET="replace-me-with-a-long-random-string"

ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=30

# SMS module (Module 09). Provider adapters: console | africastalking | twilio
SMS_PROVIDER="console"
SMS_SENDER_ID="Raut"
SMS_API_KEY=""
SMS_API_USERNAME=""

# Base URL the Flutter app points at during development.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Payment gateways ────────────────────────────────────────────────
# Credentials live here, never per-tenant in the database: a database dump
# should not hand anyone the means to move money. A gateway with no
# credentials is simply not offered to reps.

# Paystack (cards, bank, mobile money)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# M-Pesa via Safaricom Daraja. MPESA_ENV=sandbox|production
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
# CustomerPayBillOnline for a paybill, CustomerBuyGoodsOnline for a till
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"

# KCB Buni. KCB_ENV=sandbox|production
KCB_ENV="sandbox"
KCB_CONSUMER_KEY=""
KCB_CONSUMER_SECRET=""
KCB_TILL_NUMBER=""
KCB_WEBHOOK_SECRET=""

# Where providers should send callbacks. Must be publicly reachable — a
# handset's own origin is not, so this is configuration rather than inference.
PUBLIC_BASE_URL="https://raut.co.ke"

# Master key for tenant credential encryption. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=""
